# Canonical site origin, public. Production URL until a custom domain exists.
NEXT_PUBLIC_SITE_URL=

# Resend sending-only API key (server secret). Needed for the contact form.
RESEND_API_KEY=

# Owner address that receives contact messages (server).
CONTACT_TO_EMAIL=

# Verified sender, e.g. "Portfolio <contato@example.com>" (server).
CONTACT_FROM_EMAIL=

# Neon connection string for role portfolio_app, pooled host (server secret).
DATABASE_URL=

# Neon owner role for drizzle-kit migrations. Local only, never set on Vercel.
DATABASE_MIGRATION_URL=

# 32 random bytes, base64url. Salts IP hashes for rate limiting (server secret).
RATE_LIMIT_SALT=

# "true" renders the comments panel and enables /api/comments. Default false.
COMMENTS_ENABLED=

# Reserved for a later phase. Ignored in v1.
COMMENTS_IMAGES_ENABLED=

# Reserved for a later phase, only with comment images (server secret).
BLOB_READ_WRITE_TOKEN=
